Screen {
    background: $surface;
}

#dashboard, #setup, #settings, #sync, #quarantine {
    padding: 1 2;
    height: 1fr;
}

#status {
    border: round $primary;
    padding: 1 2;
    margin-bottom: 1;
}

.card {
    border: round $panel-darken-2;
    padding: 1 2;
    margin-bottom: 1;
    height: auto;
}

.help {
    color: $text-muted;
    margin-bottom: 1;
}

.status {
    margin-top: 1;
    height: auto;
}

#actions, #controls, #q_controls, #setup_controls, #settings_controls {
    height: auto;
    margin-top: 1;
}

#actions Button, #controls Button, #q_controls Button,
#setup_controls Button, #settings_controls Button {
    margin: 0 1 0 0;
}

#rows, #q_table {
    height: 1fr;
    min-height: 6;
    margin-top: 1;
}

#yt_headers {
    height: 6;
    margin-bottom: 1;
}

ProgressBar {
    margin: 1 0;
}

#summary, #phase, #mode {
    height: auto;
}
